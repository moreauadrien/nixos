#!/usr/bin/env bash

LOCK=" Lock"
REBOOT=" Reboot"
SHUTDOWN=" Shutdown"
 
choice=$(printf "%s\n%s\n%s" "$LOCK" "$REBOOT" "$SHUTDOWN" | walker --dmenu --nosearch --height 1)
 
case "$choice" in
    "$LOCK")
        hyprlock
        ;;
    "$REBOOT")
        systemctl reboot
        ;;
    "$SHUTDOWN")
        systemctl poweroff
        ;;
esac
 
